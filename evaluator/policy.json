{
  "version": "0.9.0-proposed",
  "verification": {
    "delay_hours": 24,
    "escalation_hours": 2,
    "followup_hours": 48,
    "repeat_window_days": 7,
    "routine_eta_minor_seconds": 60,
    "deadline_minor_seconds": 1,
    "port_timezones": {"NLRTM": "Europe/Amsterdam"},
    "port_names": {"NLRTM": "Rotterdam"}
  },
  "criteria": {
    "shipment_identity": {
      "method": "binary",
      "critical": true
    },
    "milestone_status": {
      "method": "binary",
      "applies_when": "status_reply_in_scope"
    },
    "sent_action_claim": {
      "method": "binary",
      "critical": true,
      "applies_when": "sent_action_claim_in_scope",
      "default_applicability": false
    },
    "eta_accuracy": {
      "method": "distance",
      "applies_when": "eta_reply_in_scope",
      "zero_score_early_seconds": 72000,
      "zero_score_late_seconds": 72000
    },
    "eta_request_answered": {
      "method": "binary",
      "applies_when": "eta_requested",
      "default_applicability": false
    },
    "coordination_eta": {
      "method": "distance",
      "zero_score_early_seconds": 72000,
      "zero_score_late_seconds": 72000,
      "zero_score_on_cutoff_crossing": true
    },
    "arrival_decision": {
      "method": "binary"
    },
    "initial_escalation": {
      "method": "checklist",
      "applies_when": "escalation_required",
      "steps": ["opened_case", "routed_to_operations"],
      "critical_steps": ["opened_case", "routed_to_operations"]
    },
    "escalation_deadline": {
      "method": "deadline",
      "applies_when": "escalation_required"
    },
    "follow_up_deadline": {
      "method": "deadline",
      "applies_when": "follow_up_required"
    }
  },
  "profiles": {
    "shipment_status": ["shipment_identity", "milestone_status", "eta_accuracy", "eta_request_answered", "sent_action_claim"],
    "arrival_coordination": [
      "shipment_identity", "milestone_status", "coordination_eta", "eta_request_answered", "arrival_decision",
      "initial_escalation", "escalation_deadline", "follow_up_deadline", "sent_action_claim"
    ],
    "shipment_delay": [
      "shipment_identity",
      "milestone_status",
      "eta_accuracy",
      "eta_request_answered",
      "initial_escalation",
      "escalation_deadline",
      "follow_up_deadline",
      "sent_action_claim"
    ]
  }
}
